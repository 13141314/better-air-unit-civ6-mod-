<?xml version="1.0" encoding="utf-8"?>
<Mod id="0a80f989-804e-44db-adf7-d209002e353b" version="1.0.0">
  <Properties>
    <Name>Better Air Units - 移动力制飞机</Name>
    <Description>飞机按移动力行动：改变基地（部署）后保留剩余移动力，剩余移动力大于 0 时仍可继续空袭；飞满全距离则和原版一样结束回合。空袭按实际战力比值与距离消耗移动力（小数余额累积）。新增：陆海军主动截击敌方空军；交易页机位租借——征得伙伴玩家同意后，飞机可进驻其航空港/市中心/跑道。　｜　v1.0.0（2026-10-03）</Description>
    <Teaser>移动力制飞机：部署后可空袭，空袭按战力与距离消耗移动力</Teaser>
    <Authors>MungBeal_SL</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <UpdateDatabase id="BetterAirUnits_Database">
      <Properties>
        <LoadOrder>50</LoadOrder>
      </Properties>
      <File>Data/BetterAirUnits.xml</File>
      
    </UpdateDatabase>
    <!-- 防空射程数据补丁：LoadOrder 必须大于所有其他模组（本机实测最大 2000000000），
         否则会被后面加载的模组（如 Bottlep Open Fire NewAction=99999999）用
         "UPDATE Units SET RangedCombat = Combat - 15, Range = 1" 覆盖回 1 格。 -->
    <UpdateDatabase id="BetterAirUnits_AAPatch">
      <Properties>
        <LoadOrder>2100000000</LoadOrder>
      </Properties>
      <File>Data/BetterAirUnitsPatch.sql</File>
    </UpdateDatabase>
    <UpdateText id="BetterAirUnits_Text">
      <Properties>
        <LoadOrder>51</LoadOrder>
      </Properties>
      <File>Text/BetterAirUnits_Text.xml</File>
    </UpdateText>
    <AddGameplayScripts id="BetterAirUnits_Scripts">
      <Properties>
        <LoadOrder>100</LoadOrder>
      </Properties>
      <File>Scripts/BetterAirUnits.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="BetterAirUnits_UI">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>101</LoadOrder>
      </Properties>
      <File>UI/BetterAirUnitsUI.xml</File>
    </AddUserInterfaces>
    <ImportFiles id="BetterAirUnits_UI_Import">
      <Properties>
        <LoadOrder>101</LoadOrder>
      </Properties>
      <File>UI/BetterAirUnitsUI.lua</File>
      <File>UI/BetterAirUnitsUI.xml</File>
    </ImportFiles>
    <ReplaceUIScript id="BetterAirUnits_WorldInput">
      <Properties>
        <LoadOrder>200000</LoadOrder>
        <LuaContext>WorldInput</LuaContext>
        <LuaReplace>UI/BetterAirUnitsWorldInput.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BetterAirUnits_UnitPanel">
      <Properties>
        <LoadOrder>300000</LoadOrder>
        <LuaContext>UnitPanel</LuaContext>
        <LuaReplace>UI/BetterAirUnitsUnitPanel.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="BetterAirUnits_DealView">
      <Properties>
        <LoadOrder>400000</LoadOrder>
        <LuaContext>DiplomacyDealView</LuaContext>
        <LuaReplace>UI/BetterAirUnitsDealView.lua</LuaReplace>
      </Properties>
    </ReplaceUIScript>
  </InGameActions>
  <Files>
    <File>Data/BetterAirUnits.xml</File>
    <File>Data/BetterAirUnitsPatch.sql</File>
    <File>Text/BetterAirUnits_Text.xml</File>
    <File>Scripts/BetterAirUnits.lua</File>
    <File>UI/BetterAirUnitsUI.lua</File>
    <File>UI/BetterAirUnitsUI.xml</File>
    <File>UI/BetterAirUnitsWorldInput.lua</File>
    <File>UI/BetterAirUnitsUnitPanel.lua</File>
    <File>UI/BetterAirUnitsDealView.lua</File>
  </Files>
</Mod>
